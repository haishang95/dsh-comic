{
  "name": "dsh-comic",
  "version": "0.3.0",
  "private": true,
  "description": "DSH 漫画下载：调 jmcomic 下载本子号为目录，再拼成 A4 PDF（JPEG 零重编码直通 + xref 校验），带搜索/选择/悬浮入口的界面。Comic downloader and PDF builder for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "lib"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
